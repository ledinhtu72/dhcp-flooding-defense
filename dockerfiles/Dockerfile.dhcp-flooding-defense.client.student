# Dockerfile: Ubuntu Client container for dhcp-flooding-defense lab
FROM huynguyen1324/dhcp-lab.client.student:backup-orig

LABEL version=3
LABEL base=labtainers/labtainer.network.ssh2.5a46b1ccd9e9

COPY client/_system/ /
RUN chmod +x /usr/local/bin/client-test.sh && \
    touch /var/log/client_dhcp_test.log && \
    chmod 666 /var/log/client_dhcp_test.log && \
    rm -rf /var/labtainer/did_param /home/ubuntu/.local/result/* /home/ubuntu/.local/zip/* && \
    : > /home/ubuntu/.local/.email && \
    : > /home/ubuntu/.local/.labname && \
    : > /home/ubuntu/.local/.seed && \
    : > /home/ubuntu/.local/.watermark && \
    chown -R ubuntu:ubuntu /home/ubuntu/.local

USER root
