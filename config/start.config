# Filename : start.config
# Description:
#     DHCP Flooding Attack, PCAP/Zeek Forensics & nftables Firewall Defense Lab
#     Dual-Subnet Architecture:
#       - INTERNAL_NET: 192.168.0.0/24 (DHCP Server + Relay Internal)
#       - EXTERNAL_NET: 10.10.0.0/24   (DHCP Relay External + Attacker + Client)

GLOBAL_SETTINGS
    GRADE_CONTAINER dhcprelay
    HOST_HOME_XFER seed_dir/
    LAB_MASTER_SEED dhcp_flooding_defense_seed
    REGISTRY zeus183

NETWORK INTERNAL_NET
    MASK 192.168.0.0/24
    GATEWAY 192.168.0.254

NETWORK EXTERNAL_NET
    MASK 10.10.0.0/24
    GATEWAY 10.10.0.254

# DHCP Server (Linux ISC DHCP) - Connected to INTERNAL_NET
CONTAINER dhcpserver
    USER ubuntu
    TERMINALS 1
    INTERNAL_NET 192.168.0.100:02:42:c0:a8:00:64
    X11 YES

# DHCP Relay + nftables Firewall + PCAP/Zeek Forensics - Dual homed router/relay
CONTAINER dhcprelay
    USER ubuntu
    TERMINALS 1
    INTERNAL_NET 192.168.0.1:02:42:c0:a8:00:01
    EXTERNAL_NET 10.10.0.1:02:42:0a:0a:00:01
    X11 YES

# Kali Attacker - Connected to EXTERNAL_NET
CONTAINER attacker
    USER ubuntu
    TERMINALS 1
    EXTERNAL_NET 10.10.0.20:02:42:0a:0a:00:14
    X11 YES

# Ubuntu Client - Connected to EXTERNAL_NET
CONTAINER client
    USER ubuntu
    TERMINALS 1
    EXTERNAL_NET 10.10.0.50:02:42:0a:0a:00:32
    X11 YES
