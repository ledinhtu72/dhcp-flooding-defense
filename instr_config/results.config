# results.config
# Assessment results for dhcp-flooding-defense lab

_client_lease = client:/var/lib/dhcp/dhclient.leases : CONTAINS : fixed-address 10.10.0
_client_lease_count = client:/var/lib/dhcp/dhclient.leases : STRING_COUNT : fixed-address 10.10.0
_client_rel_hist = client:/root/.bash_history : CONTAINS : dhclient -r
_client_rel_user = client:/home/ubuntu/.bash_history : CONTAINS : dhclient -r
_client_test_log = client:/var/log/client_dhcp_test.log : CONTAINS : CLIENT_DHCP_OK
_pcap_baseline = dhcprelay:/var/log/captures/capture_status.log : CONTAINS : normal
_pcap_before = dhcprelay:/var/log/captures/capture_status.log : CONTAINS : attack_before.pcapng
_pcap_after = dhcprelay:/var/log/captures/capture_status.log : CONTAINS : attack_after.pcapng
_attack_controlled = attacker:/var/log/attack_flood.log : CONTAINS : ATTACK_COMPLETED
_attack_yersinia = attacker:/root/.bash_history : CONTAINS : yersinia
_attack_yersinia_u = attacker:/home/ubuntu/.bash_history : CONTAINS : yersinia
_attack_scapy = attacker:/root/.bash_history : CONTAINS : dhcp_flood_scapy
_attack_scapy_u = attacker:/home/ubuntu/.bash_history : CONTAINS : dhcp_flood_scapy
_nft_enabled = dhcprelay:/var/log/firewall_status.log : CONTAINS : NFT_DEFENSE_ACTIVE
_nft_dropped = dhcprelay:/var/log/firewall_status.log : CONTAINS : NFT_DEFENSE_VERIFIED_DROPS
_zeek_report = dhcprelay:/var/log/dhcp_analysis_report.txt : CONTAINS : ZEEK_PYTHON_REPORT_COMPLETED
