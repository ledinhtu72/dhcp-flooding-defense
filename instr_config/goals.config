# goals.config
# Assessment goals for dhcp-flooding-defense lab

# DOC: Client successfully obtained dynamic IP at baseline from DHCP Server
client_base_ip = matchany : string_equal : _client_lease : answer=True

_has_pcap_norm = matchany : string_equal : _pcap_baseline : answer=True
_has_pcap_bef = matchany : string_equal : _pcap_before : answer=True
_has_pcap_aft = matchany : string_equal : _pcap_after : answer=True

# DOC: Captured all 3 PCAPNG files (normal_dhcp, attack_before, attack_after)
pcap_captured = boolean : ( _has_pcap_norm and _has_pcap_bef and _has_pcap_aft )

_att_ctrl = matchany : string_equal : _attack_controlled : answer=True
_att_yer = matchany : string_equal : _attack_yersinia : answer=True
_att_yer_u = matchany : string_equal : _attack_yersinia_u : answer=True
_att_scp = matchany : string_equal : _attack_scapy : answer=True
_att_scp_u = matchany : string_equal : _attack_scapy_u : answer=True

# DOC: Attacker executed controlled DHCP flooding attack
flood_attack = boolean : ( _att_ctrl or _att_yer or _att_yer_u or _att_scp or _att_scp_u )

_nft_act = matchany : string_equal : _nft_enabled : answer=True
_nft_drp = matchany : string_equal : _nft_dropped : answer=True

# DOC: nftables firewall enabled on Relay and verified dropping flood packets via counters
nft_defense = boolean : ( _nft_act and _nft_drp )

_cli_multi = matchany : integer_greater : _client_lease_count : answer=1
_cli_r_root = matchany : string_equal : _client_rel_hist : answer=True
_cli_r_user = matchany : string_equal : _client_rel_user : answer=True
_cli_t_log = matchany : string_equal : _client_test_log : answer=True

# DOC: Client released and successfully obtained IP under/after nftables defense
client_defense = boolean : ( _cli_multi or _cli_r_root or _cli_r_user or _cli_t_log )

# DOC: Zeek and Python analyzed PCAP files and generated statistical comparison report
zeek_analysis = matchany : string_equal : _zeek_report : answer=True
